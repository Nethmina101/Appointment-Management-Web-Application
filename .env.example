# Copy this file to .env and fill in real values
# Never commit .env to version control

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret – generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=2h

# Frontend origin (set to your actual domain in production)
FRONTEND_ORIGIN=http://localhost:5000

# Seed admin credentials (used only by npm run seed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass@123
